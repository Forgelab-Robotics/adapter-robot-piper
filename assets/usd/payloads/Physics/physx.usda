#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "PIPER"
    doc = """Generated from the repository's AgileX Piper MJCF asset


Generated from the repository's AgileX Piper MJCF asset


Generated from the repository's AgileX Piper MJCF asset


Generated from the repository's AgileX Piper MJCF asset
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "PIPER"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "link1"
            {
                over "link2"
                {
                    over "link3"
                    {
                        over "link4"
                        {
                            over "link5"
                            {
                                over "link6"
                                {
                                    over "link7"
                                    {
                                        over "joint7" (
                                            prepend apiSchemas = ["PhysxJointAPI"]
                                        )
                                        {
                                            float physxJoint:armature = 0.005
                                        }
                                    }

                                    over "link8"
                                    {
                                        over "joint8" (
                                            prepend apiSchemas = ["PhysxJointAPI"]
                                        )
                                        {
                                            float physxJoint:armature = 0.005
                                        }
                                    }

                                    over "joint6" (
                                        prepend apiSchemas = ["PhysxJointAPI"]
                                    )
                                    {
                                        float physxJoint:armature = 0.005
                                        float physxJoint:jointFriction = 0.3
                                    }
                                }

                                over "joint5" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                    float physxJoint:armature = 0.005
                                    float physxJoint:jointFriction = 0.3
                                }
                            }

                            over "joint4" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.005
                                float physxJoint:jointFriction = 0.3
                            }
                        }

                        over "joint3" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.005
                            float physxJoint:jointFriction = 0.3
                        }
                    }

                    over "joint2" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.005
                        float physxJoint:jointFriction = 0.3
                    }
                }

                over "joint1" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.005
                    float physxJoint:jointFriction = 0.3
                }
            }
        }
    }
}

