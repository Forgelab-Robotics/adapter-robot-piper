        </PIPER/Geometry/base_link/link1/link2/link3/link4/link5/link6/link8>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "link6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "link7" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "joint7" (
                                            prepend apiSchemas = ["IsaacJointAPI"]
                                        )
                                        {
                                        }
                                    }

                                    over "link8" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "joint8" (
                                            prepend apiSchemas = ["IsaacJointAPI"]
                                        )
                                        {
                                        }
                                    }

                                    over "joint6" (
                                        prepend apiSchemas = ["IsaacJointAPI"]
                                    )
                                    {
                                    }
                                }

                                over "joint5" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }
                            }

                            over "joint4" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
